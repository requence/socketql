{
  "name": "@requence/socketql",
  "version": "1.8.0",
  "description": "Socket.IO-based GraphQL transport with live queries, URQL client, and React hooks",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/server/index.js",
  "module": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    "./server": {
      "bun": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./server/bun": {
      "bun": "./src/server/bun.ts",
      "types": "./dist/server/bun.d.ts",
      "import": "./dist/server/bun.js",
      "default": "./dist/server/bun.js"
    },
    "./server/redis": {
      "bun": "./src/server/redis.ts",
      "types": "./dist/server/redis.d.ts",
      "import": "./dist/server/redis.js",
      "default": "./dist/server/redis.js"
    },
    "./client": {
      "bun": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./client/react": {
      "bun": "./src/client/react/index.ts",
      "types": "./dist/client/react/index.d.ts",
      "import": "./dist/client/react/index.js",
      "default": "./dist/client/react/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "NODE_ENV=production bun run build.ts",
    "check-types": "tsc --noEmit",
    "cs": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@envelop/live-query": "^8.1.3",
    "@graphql-tools/schema": "^10.0.25",
    "@graphql-tools/utils": "^10.9.1",
    "@n1ru4l/graphql-live-query-patch-jsondiffpatch": "^0.8.0",
    "@n1ru4l/in-memory-live-query-store": "^0.10.0",
    "@n1ru4l/push-pull-async-iterable-iterator": "^3.2.0",
    "@n1ru4l/socket-io-graphql-client": "^0.13.0",
    "@n1ru4l/socket-io-graphql-server": "^0.13.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "dataloader": "^2.2.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "wonka": "^6.3.5"
  },
  "peerDependencies": {
    "@socket.io/bun-engine": ">=0.1.0",
    "graphql": "^16.11.0",
    "ioredis": "^5.9.3",
    "react": "^18.0.0 || ^19.0.0",
    "urql": "^4.2.2"
  },
  "peerDependenciesMeta": {
    "@socket.io/bun-engine": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "urql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@socket.io/bun-engine": "^0.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^22.17.2",
    "@types/react": "^19.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "globals": "^17.5.0",
    "graphql": "^16.11.0",
    "ioredis": "^5.9.3",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "urql": "^4.2.2"
  },
  "license": "MIT",
  "homepage": "https://socketql.docs.requence.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/requence/socketql.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
